import assert from "node:assert/strict";import test from "node:test";import { advance,parseSupervision } from "./supervision.js";
test("uses the reference rule defaults",()=>{assert.deepEqual(parseSupervision({}),{enabled:false,rangeMinutes:15,threshold:3});assert.deepEqual(parseSupervision({enabled:true,rangeMinutes:4,threshold:9}),{enabled:true,rangeMinutes:15,threshold:3});});
test("initial read only baselines",()=>{const s=parseSupervision({enabled:true,rangeMinutes:5,threshold:2});assert.equal(advance(undefined,"a",0,s).alert,undefined)});test("activity and failures reset strikes",()=>{const s=parseSupervision({enabled:true,rangeMinutes:5,threshold:2});const a=advance({idleSince:0,checks:1,signature:"a"},"b",600000,s);assert.equal(a.next.checks,0);assert.equal(advance(a.next,undefined,700000,s,true).next.checks,0)});test("threshold alerts after consecutive windows",()=>{const s=parseSupervision({enabled:true,rangeMinutes:5,threshold:2});const a=advance({idleSince:0,checks:0,signature:"a"},"a",300000,s);assert.equal(a.alert,undefined);assert.equal(advance(a.next,"a",600000,s).alert?.checks,2)});

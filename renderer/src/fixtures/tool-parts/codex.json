            },
            {
              "path": "src/app.ts",
              "kind": { "type": "update" },
              "diff": "@@ -1,3 +1,3 @@\n-const version = 1;\n+const version = 2;\n export const app = version;\n"
            },
            {
              "path": "src/obsolete.ts",
              "kind": { "type": "delete" },
              "diff": "@@ -1,1 +0,0 @@\n-export const obsolete = true;\n"
            }

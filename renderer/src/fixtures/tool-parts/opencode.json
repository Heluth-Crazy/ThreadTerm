        "data": {
          "id": "prt_bash_02",
          "messageID": "msg_02",
          "sessionID": "ses_01",
          "type": "tool",
          "tool": "bash",
          "callID": "call_bash_02",
          "state": {
            "status": "error",
            "title": "Run the tests",
            "input": { "command": "npm test" },

    {
      "id": "opencode-bash",
      "kind": "command",
      "expect": { "command": "npm test", "exitCode": 0 },
      "part": {
        "type": "tool",
        "toolId": "prt_bash_01",
        "toolName": "bash",
        "status": "completed",
        "data": {
          "id": "prt_bash_01",
          "messageID": "msg_01",
          "sessionID": "ses_01",
          "type": "tool",
          "tool": "bash",
          "callID": "call_bash_01",
          "state": {
            "status": "completed",
            "title": "Run the tests",
            "input": { "command": "npm test" },
            "output": "all tests passed",
            "metadata": { "exit": 0 },
            "time": { "start": 1, "end": 2 }
          }
        }
      }
    },
    {
      "id": "opencode-bash-failed",
      "kind": "command",
      "expect": { "command": "npm test", "status": "failed" },

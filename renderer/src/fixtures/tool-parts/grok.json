{
  "provider": "grok",
  "note": "Synthetic ChatPart shapes for Grok's ACP-shaped JSON-RPC. A tool part's data is the update object, enriched with _meta['x.ai/tool'] identity when present, and toolName is the identity label/name. Shapes derived from runtime/src/providers/grok.rs (grok_tool_part, grok_tool_part_preserving_identity) and runtime/tests/fixtures/grok-question-frames.jsonl.",
  "cases": [
    {
      "id": "grok-read",
      "kind": "read",
      "expect": { "path": "src/app.ts" },
      "part": {
        "type": "tool",
        "toolId": "call-read-01",
        "toolName": "Read File",
        "status": "complete",
        "data": {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call-read-01",
          "status": "completed",
          "rawInput": { "path": "src/app.ts" },
          "rawOutput": { "content": [{ "type": "text", "text": "Read 42 lines" }] },
          "_meta": {
            "x.ai/tool": {
              "version": 1,
              "name": "read_file",
              "kind": "read",
              "namespace": "grok_build",
              "label": "Read File",
              "read_only": true
            }
          }
        }
      }
    },
    {
      "id": "grok-edit",
      "kind": "edit",
      "expect": { "files": 1, "change": "modify" },
      "part": {
        "type": "tool",
        "toolId": "call-edit-01",
        "toolName": "Edit File",
        "status": "complete",
        "data": {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call-edit-01",
          "status": "completed",
          "content": [
            { "type": "diff", "path": "src/app.ts", "oldText": "const version = 1;\n", "newText": "const version = 2;\n" }
          ],
          "_meta": {
            "x.ai/tool": {
              "version": 1,
              "name": "edit_file",
              "kind": "edit",
              "namespace": "grok_build",
              "label": "Edit File",
              "read_only": false
            }
          }
        }
      }
    },
    {
      "id": "grok-command",
      "kind": "command",
      "expect": { "command": "npm run lint" },
      "part": {
        "type": "tool",
        "toolId": "call-exec-01",
        "toolName": "Run Command",
        "status": "complete",
        "data": {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call-exec-01",
          "status": "completed",
          "rawInput": { "command": "npm run lint" },
          "rawOutput": { "content": [{ "type": "text", "text": "lint clean" }] },
          "_meta": {
            "x.ai/tool": {
              "version": 1,
              "name": "run_command",
              "kind": "execute",
              "namespace": "grok_build",
              "label": "Run Command",
              "read_only": false
            }
          }
        }
      }
    },
    {
      "id": "grok-search",
      "kind": "search",
      "expect": { "query": "describeTool" },
      "part": {
        "type": "tool",
        "toolId": "call-search-01",
        "toolName": "Search Files",
        "status": "complete",
        "data": {
          "sessionUpdate": "tool_call_update",
          "toolCallId": "call-search-01",
          "status": "completed",
          "rawInput": { "query": "describeTool", "path": "renderer/src" },
          "_meta": {
            "x.ai/tool": {
              "version": 1,
              "name": "search_files",
              "kind": "search",
              "namespace": "grok_build",
              "label": "Search Files",
              "read_only": true
            }
          }
        }
      }
    },
    {
      "id": "grok-web",

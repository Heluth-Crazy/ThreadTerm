{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "types": ["react"]
  },
  "include": ["index.ts", "App.tsx", "src/**/*.ts", "src/**/*.tsx", "modules/**/*.ts", "modules/**/*.tsx"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "node_modules", "ios", "native-client"]
}

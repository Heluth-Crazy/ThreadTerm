{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwork.local/diagram-request.schema.json",
  "title": "DiagramRequest",
  "type": "object",
  "required": ["title", "diagram_type", "nodes"],
  "properties": {
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "diagram_type": {
      "type": "string",
      "enum": ["architecture", "workflow", "module-map", "concept-map", "sequence", "topology"]
    },
    "variant": {"type": "string"},
    "lang": {"type": "string", "default": "zh-CN"},
    "theme": {"type": "string", "default": "dark-tech"},
    "audience": {"type": "string"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "group": {"type": "string"},
          "kind": {"type": "string"},
          "title": {"type": "string"},
          "body": {"type": "string"},
          "x": {"type": "number"},
          "y": {"type": "number"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string"},
          "style": {"type": "string", "enum": ["solid", "dashed", "highlight"]}
        }
      }
    },
    "legend": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": {"type": "string"},
          "kind": {"type": "string"}
        }
      }
    }
  }
}
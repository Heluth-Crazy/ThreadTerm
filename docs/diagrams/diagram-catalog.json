{
  "version": "1.0",
  "default_lang": "zh-CN",
  "default_theme": "dark-tech",
  "fixed_flow": [
    "识别目标",
    "选择图类",
    "组织结构化输入",
    "选择模板变体",
    "生成 SVG",
    "导出 PNG 并人工复核"
  ],
  "diagram_types": [
    {
      "id": "architecture",
      "label": "架构图",
      "template": "architecture-template.svg",
      "variants": ["overview", "layered", "runtime", "deployment"],
      "best_for": ["系统全景", "分层架构", "运行时结构", "技术汇报"]
    },
    {
      "id": "workflow",
      "label": "流程图",
      "template": "workflow-template.svg",
      "variants": ["linear", "swimlane", "approval", "loop"],
      "best_for": ["业务流程", "状态流转", "执行链路", "审批分支"]
    },
    {
      "id": "module-map",
      "label": "模块关系图",
      "template": "module-map-template.svg",
      "variants": ["dependency", "ownership", "capability"],
      "best_for": ["模块职责", "依赖关系", "子系统映射"]
    },
    {
      "id": "concept-map",
      "label": "概念图",
      "template": "concept-map-template.svg",
      "variants": ["radial", "cluster", "layered"],
      "best_for": ["能力地图", "概念拆解", "主题关系"]
    },
    {
      "id": "sequence",
      "label": "时序图",
      "template": "sequence-template.svg",
      "variants": ["sync", "async", "multi-actor"],
      "best_for": ["请求响应", "角色交互", "调用顺序"]
    },
    {
      "id": "topology",
      "label": "拓扑图",
      "template": "topology-template.svg",
      "variants": ["network", "deployment", "regional"],
      "best_for": ["部署结构", "节点分布", "接入拓扑"]
    }
  ]
}
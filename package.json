{
  "name": "threadterm",
  "version": "0.3.0",
  "description": "A desktop terminal manager for project-bound shell and AI CLI sessions",
  "type": "module",
  "files": [
    "dist/",
    "README.md"
  ],
  "homepage": "https://github.com/Heluth-Crazy/ThreadTerm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heluth-Crazy/ThreadTerm.git"
  },
  "bugs": {
    "url": "https://github.com/Heluth-Crazy/ThreadTerm/issues"
  },
  "scripts": {
    "client": "vite --host",
    "build": "vite build",

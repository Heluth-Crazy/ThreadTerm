{
  "name": "threadterm",
  "version": "0.3.0",
  "description": "A desktop terminal manager for project-bound shell and AI CLI sessions",
  "type": "module",
  "files": [
    "dist/",
    "README.md"
  ],
  "homepage": "https://github.com/Heluth-Crazy/ThreadTerm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heluth-Crazy/ThreadTerm.git"
  },
  "bugs": {
    "url": "https://github.com/Heluth-Crazy/ThreadTerm/issues"
  },
  "scripts": {
    "client": "vite --host",
    "dev:desktop": "npm run build:sidecar && npm run build:mobile && npm run client",
    "dev:mobile": "vite --config mobile-app/vite.config.ts --host",
    "build": "vite build",
    "build:mobile": "vite build --config mobile-app/vite.config.ts",
    "ios:dev": "echo \"ios:dev requires macOS + Xcode. See mobile-app/src-tauri/README.md\" && npx tauri ios dev --config mobile-app/src-tauri/tauri.conf.json",
    "ios:build": "echo \"ios:build requires macOS + Xcode + signing. See mobile-app/src-tauri/README.md\" && npx tauri ios build --config mobile-app/src-tauri/tauri.conf.json",
    "test:mobile": "vitest run mobile-app/src",
    "build:sidecar": "npm --prefix sidecar/claude-host install --no-audit --no-fund && npm --prefix sidecar/claude-host run build",
    "test:sidecar": "npm --prefix sidecar/claude-host install --no-audit --no-fund && npm --prefix sidecar/claude-host run test",
    "test:memory-tools": "node --test tools/webview-memory-lifecycle/*.test.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=21",
    "test": "vitest run",
    "clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:sidecar && npm run test:memory-tools && npm run build:mobile && npm run clippy",
    "bench:size": "node tools/bench-size.mjs",
    "bench:startup": "node tools/bench-startup.mjs",
    "bench:terminal-output": "vitest bench benchmarks/terminal-output.bench.ts --run",
    "memory:analyze": "node tools/webview-memory-lifecycle/analyze-samples.mjs",
    "memory:sample:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/webview-memory-lifecycle/run-windows-scenarios.ps1",
    "test:e2e:mobile": "playwright test -c playwright.config.ts",
    "test:e2e:mobile-real": "npm run build:mobile && playwright test -c e2e/mobile-real/playwright.config.ts && playwright test -c e2e/mobile-real/playwright.webkit.config.ts",
    "test:e2e:desktop": "playwright test -c e2e/desktop/playwright.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "release": "release-it",
    "prepublishOnly": "npm run build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --config src-tauri/tauri.windows.conf.json --bundles nsis"
  },
  "keywords": [
    "threadterm",
    "ai",
    "terminal",
    "workspace",
    "desktop"
  ],
  "author": "ThreadTerm Contributors",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.4",
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "highlight.js": "11.11.1",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.515.0",
    "marked": "15.0.12",
    "marked-highlight": "2.2.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.3",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@release-it/conventional-changelog": "^10.0.5",
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.17",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.8.9",
    "postcss": "^8.4.32",
    "release-it": "^19.0.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.0.4",
    "vitest": "^4.1.2"
  }
}
